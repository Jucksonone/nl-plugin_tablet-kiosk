[Unit]
Description=Tablet kiosk agent (player, capture; driven by the Natural Land plugin)
After=pipewire.service wireplumber.service

[Service]
# DISPLAY / XAUTHORITY are imported by the XDG autostart entry before it starts us.
Environment=GST_GL_API=gles2 GST_GL_PLATFORM=egl PYTHONUNBUFFERED=1
WorkingDirectory=%h/kiosk/device
ExecStart=/usr/bin/python3 -m kiosk
Restart=always
RestartSec=5
# Stopping finalises the running capture's last segment.
TimeoutStopSec=30
