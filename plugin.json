          "zh-CN": "平板终端",
          "en": "Tablet kiosk"
        }
      },
      {
        "slot": "experiment.tab",
        "module": "./ExperimentTab",
        "title": {
          "zh-CN": "平板终端",
          "en": "Tablet kiosk"
        }
      },
      {
        "slot": "record.tab",
        "module": "./RecordTab",
        "title": {
